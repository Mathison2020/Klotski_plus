{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/__tests__/**"],
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-return": "off"
  },
  "env": {
    "builtin": true,
    "es2023": true,
    "browser": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  }
}
